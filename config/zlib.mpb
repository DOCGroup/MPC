// -*- MPC -*-
feature(zlib) {
  expand(ZLIB_INCDIR) {
    $ZLIB_INCDIR
    $(ZLIB_ROOT)/include
  }
  expand(ZLIB_LIBDIR) {
    $ZLIB_LIBDIR
    $(ZLIB_ROOT)/lib
  }

  includes += "$(ZLIB_INCDIR)"
  libpaths += "$(ZLIB_LIBDIR)"
  macros   += ZLIB

  specific(prop:windows) {
    // zlib 1.4 names its MSVC libraries libz, libzd, libzs and libzsd,
    // which matches libz with the lib_modifier MPC adds
    libs += libz
  } else {
    lit_libs += z
  }
}
