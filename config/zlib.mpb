// -*- MPC -*-
feature(zlib) {
  expand(ZLIB_INCDIR) {
    $ZLIB_INCDIR
    $(ZLIB_ROOT)/include
  }
  expand(ZLIB_LIBDIR) {
    $ZLIB_LIBDIR
    $(ZLIB_ROOT)/lib
  }
  expand(ZLIB_LIBNAME) {
    $ZLIB_LIBNAME
    libz
  }

  includes += "$(ZLIB_INCDIR)"
  libpaths += "$(ZLIB_LIBDIR)"
  macros   += ZLIB

  specific(prop:windows) {
    // zlib 1.4 names its MSVC libraries libz, libzd, libzs and libzsd,
    // which matches libz with the lib_modifier MPC adds. Set ZLIB_LIBNAME
    // to z for older zlib versions that use z, zd, zs and zsd.
    libs += $(ZLIB_LIBNAME)
  } else {
    lit_libs += z
  }
}
